# PriceEdge production configuration
PORT=3000
NODE_ENV=production
APP_URL=https://your-priceedge-domain.example
JWT_SECRET=generate-a-long-random-secret
TWELVE_DATA_API_KEY=your-twelve-data-api-key
FRED_API_KEY=your-fred-api-key
ECONOMIC_CALENDAR_URL=https://your-provider.example/calendar
ECONOMIC_CALENDAR_API_KEY=your-calendar-api-key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM=PriceEdge <no-reply@example.com>
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PREMIUM_PRICE_ID=price_xxx
